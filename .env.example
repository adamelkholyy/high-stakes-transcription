# Handoff default: open the complete workspace with every AI tool enabled.
# Other modes: full | sentence. Omit for the five-version launcher.
VITE_APP_MODE=complete

# Local model API.
VITE_API_BASE=http://127.0.0.1:8000

# Optional independent local ASR service. Keep disabled when importing JSON.
VITE_ASR_BASE=http://127.0.0.1:8001
VITE_ASR_ENABLED=false
